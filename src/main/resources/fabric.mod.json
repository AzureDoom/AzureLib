{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://github.com/AzureDoom/AzureLib",
    "sources": "https://github.com/AzureDoom/AzureLib",
    "issues": "https://github.com/AzureDoom/AzureLib/issues"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "init": [
      "mod.azure.azurelib.OrnitheAzureLibMod"
    ],
    "client-init": [
      "mod.azure.azurelib.client.AzureLibClientInit"
    ]
  },
  "mixins": [
    "azurelib.mixins.json",
    {
      "config": "azurelib.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "azurelib.accesswidener",
  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "fabricloader": ">=0.19.5",
    "osl-entrypoints": "*",
    "osl-networking": "*"
  }
}
